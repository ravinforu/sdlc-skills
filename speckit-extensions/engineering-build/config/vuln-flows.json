{
  "schema_version": "1.0",
  "workspace_root": "~/work",
  "branch_prefix": "vuln/",
  "platform_repo": "shared-lib",
  "reference_paths": [
    "bom"
  ],
  "version_files": [
    "dependencies.conf",
    "gradle.properties",
    "*.gradle",
    "*.gradle.kts",
    "*.properties",
    "*.conf"
  ],
  "build": {
    "command": [
      "./gradlew",
      "clean",
      "build",
      "-x",
      "test"
    ],
    "publish_command": [
      "./gradlew",
      "publishToMavenLocal"
    ],
    "timeout_seconds": 3600,
    "version_command": [
      "./gradlew",
      "-q",
      "properties"
    ],
    "version_timeout_seconds": 900
  },
  "transitive": {
    "command": [
      "./gradlew",
      "dependencyInsight",
      "--dependency",
      "{dependency}",
      "--configuration",
      "runtimeClasspath"
    ]
  },
  "handoff": [
    {
      "from": "shared-lib",
      "version_source": "gradle",
      "to": [
        {
          "repo": "service-a",
          "file": "gradle/dependencies.conf",
          "key": "sharedLibVersion"
        },
        {
          "repo": "service-b",
          "file": "gradle/dependencies.conf",
          "key": "sharedLibVersion"
        }
      ]
    },
    {
      "from": "service-a",
      "version_source": "gradle",
      "to": [
        {
          "repo": "service-b",
          "file": "gradle/dependencies.conf",
          "key": "serviceAVersion"
        }
      ]
    }
  ],
  "repo_overrides": {},
  "base_branch": {},
  "flows": {
    "main": {
      "publish": true,
      "repos": [
        "shared-lib",
        "service-a",
        "service-b"
      ]
    }
  }
}
